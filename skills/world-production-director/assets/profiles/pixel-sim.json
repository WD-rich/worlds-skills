{
  "schemaVersion": "world-visual-profile/v1",
  "revision": 1,
  "status": "target-not-yet-produced",
  "assetRoles": [
    "scene-ground",
    "scene-occlusion",
    "navigation",
    "gameplay-sprites",
    "portraits",
    "hud-layout"
  ],
  "viewports": [
    [
      1440,
      900
    ],
    [
      1280,
      800
    ],
    [
      390,
      844
    ]
  ],
  "states": [
    "overview",
    "movement",
    "dialogue",
    "exchange-decision",
    "actor-focus",
    "collapsed",
    "narrow",
    "missing-asset",
    "reduced-motion"
  ],
  "visualCriteria": [
    "composition",
    "camera-consistency",
    "actor-grounding",
    "readable-motion",
    "material-lighting",
    "hud-hierarchy",
    "text-fit"
  ],
  "interactionCriteria": [
    "pan-zoom",
    "select-follow",
    "move-route",
    "dialogue-source",
    "play-pause-step",
    "resource-feedback",
    "context-drawer",
    "keyboard-reduced-motion"
  ],
  "release": {
    "placeholdersAllowed": false,
    "conceptOnlyAllowed": false,
    "runtimeCapturesRequired": true,
    "technicalPassApprovesArt": false,
    "requiredReviewers": [
      "codex-visual-review"
    ]
  },
  "id": "pixel-sim",
  "title": "俯视像素生活模拟",
  "camera": {
    "projection": "top-down-three-quarter",
    "coordinates": "tile-grid"
  },
  "layout": {
    "composition": "tile-map-with-compact-hud",
    "internalCanvas": [
      480,
      270
    ],
    "integerScalingPreferred": true,
    "tileSizePx": 16,
    "mapCoverageMin": 0.78,
    "hudOcclusionMax": 0.22,
    "contextMaxWidth": 288,
    "mobileDrawerMaxVw": 92
  },
  "actors": {
    "humanFramePx": [
      16,
      32
    ],
    "directions": [
      "south",
      "west",
      "east",
      "north"
    ],
    "actions": {
      "idle": 1,
      "walk": 4,
      "talk": 2,
      "interact": 2
    },
    "portraitUse": "dialogue-or-context-only",
    "anchor": "tile-feet"
  },
  "art": {
    "paletteMaxColors": 48,
    "filter": "nearest",
    "tiles": [
      "ground",
      "road",
      "wall",
      "roof",
      "door",
      "water",
      "prop"
    ],
    "lighting": "pixel-consistent"
  },
  "avoid": [
    "non-integer-blurred-pixels",
    "mixed-pixel-densities",
    "borrowed-game-assets",
    "portrait-resized-as-gameplay",
    "dashboard-card-wall"
  ]
}
